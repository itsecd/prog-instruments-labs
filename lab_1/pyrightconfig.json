{
    "include": ["."],
    "exclude": [
        "**/__pycache__",
        "**/.ruff_cache",
        "**/.pytest_cache",
        ".venv"
    ],
    "venvPath": ".",
    "venv": ".venv",
    "pythonVersion": "3.11",
    "typeCheckingMode": "standard",
    "reportMissingImports": "warning",
    "reportMissingTypeStubs": "none",
    "reportUnusedImport": "warning",
    "reportUnusedVariable": "warning"
}