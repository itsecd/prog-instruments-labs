{
  "hashing": {
    "default_algorithm": "sha256",
    "supported_algorithms": [
      "sha256",
      "sha1",
      "md5",
      "sha3_256"
    ],
    "text_encoding": "utf-8",
    "decode_errors": "replace"
  },
  "experiments": {
    "default_count": 10,
    "min_count": 1,
    "max_count": 100,
    "all_modifications_alias": "all",
    "modification_types": [
      "char",
      "bit",
      "case"
    ],
    "modification_labels": {
      "char": "Замена символа",
      "bit": "Инверсия бита (байт {byte_i}, бит {bit_i})",
      "case": "Смена регистра (позиция {pos})"
    }
  },
  "bits": {
    "hex_digit": 4,
    "byte": 8
  },
  "quality": {
    "excellent_percent": 45,
    "moderate_percent": 30,
    "warning_percent": 25,
    "ideal_percent": 50,
    "levels": {
      "excellent": {
        "title": "Отличный лавинный эффект",
        "description": "алгоритм качественный"
      },
      "moderate": {
        "title": "Умеренный лавинный эффект",
        "description": "есть слабые места"
      },
      "weak": {
        "title": "Слабый лавинный эффект",
        "description": "алгоритм ненадёжен"
      }
    }
  },
  "display": {
    "hash_preview_length": 32,
    "table_hash_preview_length": 16,
    "text_preview_length": 30,
    "progress_bar_length": 40,
    "progress_ncols": 70
  },
  "gui": {
    "window_title": "Лавинный эффект хеш-функций — Лабораторная №4",
    "min_width": 1000,
    "min_height": 680,
    "default_text": "SSAU is the best university",
    "splitter_sizes": [
      320,
      680
    ],
    "colors": {
      "excellent": "#a8d8a8",
      "warning": "#f9ca24",
      "weak": "#ff6b6b"
    }
  },
